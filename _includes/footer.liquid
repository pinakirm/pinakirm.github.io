{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}.
  {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}

  <div style="display: flex; justify-content: center; margin-top: 8px;">
    <div style="width: 200px; height: 110px; overflow: hidden;">
      <script type="text/javascript" id="mapmyvisitors" src="https://mapmyvisitors.com/map.js?d=EuSQT5Mjul0sU9R8f9XheL6-0SXci0gjuxV2_9Xg5oI&cl=1c1c1d&w=a"></script>
    </div>
  </div>
{% endcapture %}

<style>
  footer.site-footer-dark {
    background: #1c1c1d !important;
    color: #e6e6e6 !important;
    border-top: none !important;
    padding: 10px 0;
  }
  footer.site-footer-dark a { color: #e6e6e6 !important; }
  footer.site-footer-dark a:hover { color: var(--global-theme-color) !important; }
</style>

{% if site.footer_fixed %}
  <footer class="fixed-bottom site-footer-dark" role="contentinfo">
    <div class="container mt-0 text-center">{{ footer_contents }}</div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5 site-footer-dark" role="contentinfo">
    {% if site.newsletter.enabled %}{% include newsletter.liquid %}{% endif %}
    <div class="container text-center">{{ footer_contents }}</div>
  </footer>
{% endif %}
